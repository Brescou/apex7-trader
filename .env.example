# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Twitter/X sentiment (optional) — config.py reads X_BEARER_TOKEN
X_BEARER_TOKEN=

# Modes (mutually exclusive; PAPER wins if both are accidentally true)
SIMULATION_MODE=true
PAPER_MODE=false
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0001

# Optional REST/WS auth — Bearer token on REST, ?token= on /ws. /health stays open.
# DASHBOARD_PASSWORD=

# Discord alerts (optional — trades, death, stagnation, rate-limit, startup, daily digest, weekly report, evaluation)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx

# FRED API — optional; JSON access works for many popular series without a key but is rate-limited
FRED_API_KEY=

# Finnhub — fallback quotes (yfinance breaker) + company news for the terminal
# FINNHUB_API_KEY=

# Economist / geopolitician vote cache (seconds). Default 3600 = 1 h.
# SLOW_AGENT_TTL_SEC=3600

# Max additional BUY layers on the same open symbol (pyramiding); see Portfolio.buy in ``core/data.py``
MAX_PYRAMID_LAYERS=3
