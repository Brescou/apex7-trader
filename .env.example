# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Twitter/X (optionnel)
TWITTER_BEARER_TOKEN=AAAAAxxxxxxxx

# Mode simulation
SIMULATION_MODE=true
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0001

# Discord alerts (optional — trades, death, stagnation, rate-limit, startup, daily digest, weekly report, evaluation)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx

# FRED API — optional; JSON access works for many popular series without a key but is rate-limited
FRED_API_KEY=

# Max additional BUY layers on the same open symbol (pyramiding); see Portfolio.buy in ``core/data.py``
MAX_PYRAMID_LAYERS=3
